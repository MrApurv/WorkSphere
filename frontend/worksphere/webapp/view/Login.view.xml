<mvc:View
    controllerName="com.apurv.worksphere.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        id="loginPage"
        showHeader="false"
        enableScrolling="false"
        class="wsLoginPage">

        <content>

            <HBox
                id="loginLayout"
                width="100%"
                height="100%"
                alignItems="Stretch"
                class="wsLoginLayout">

                <!-- Branding section -->
                <VBox
                    id="brandingSection"
                    width="55%"
                    justifyContent="Center"
                    alignItems="Start"
                    class="wsBrandingSection">

                    <Text
                        text="WORKSPHERE"
                        class="wsBrandLabel" />

                    <Title
                        text="Transforming Employee Management with AI"
                        level="H1"
                        wrapping="true"
                        class="wsBrandTitle" />

                    <Text
                        text="An AI-powered enterprise employee management platform built using modern SAP technologies."
                        wrapping="true"
                        class="wsBrandDescription" />

                    <VBox class="wsFeatureList">

                        <HBox
                            alignItems="Center"
                            class="wsFeatureItem">

                            <core:Icon
                                src="sap-icon://employee"
                                class="wsFeatureIcon" />

                            <Text
                                text="Centralized employee management"
                                wrapping="true"
                                class="wsFeatureText" />

                        </HBox>

                        <HBox
                            alignItems="Center"
                            class="wsFeatureItem">

                            <core:Icon
                                src="sap-icon://business-objects-experience"
                                class="wsFeatureIcon" />

                            <Text
                                text="Workforce analytics and intelligent insights"
                                wrapping="true"
                                class="wsFeatureText" />

                        </HBox>

                        <HBox
                            alignItems="Center"
                            class="wsFeatureItem">

                            <core:Icon
                                src="sap-icon://collaborate"
                                class="wsFeatureIcon" />

                            <Text
                                text="AI-assisted HR and workforce decisions"
                                wrapping="true"
                                class="wsFeatureText" />

                        </HBox>

                    </VBox>

                </VBox>

                <!-- Login form section -->
                <VBox
                    id="loginFormSection"
                    width="45%"
                    justifyContent="Center"
                    alignItems="Center"
                    class="wsLoginFormSection">

                    <VBox
                        id="loginCard"
                        width="26rem"
                        class="wsLoginCard">

                        <Text
                            text="WorkSphere"
                            class="wsMobileBrandName" />

                        <Title
                            text="Welcome back"
                            level="H2"
                            class="wsLoginTitle" />

                        <Text
                            text="Sign in to access your employee workspace."
                            wrapping="true"
                            class="wsLoginSubtitle" />

                        <!-- Email field -->
                        <VBox class="wsFormField">

                            <Label
                                text="Work Email"
                                labelFor="emailInput"
                                class="wsInputLabel" />

                            <Input
                                id="emailInput"
                                value="{login>/email}"
                                type="Email"
                                placeholder="name@company.com"
                                enabled="{= !${login>/busy} }"
                                liveChange=".onEmailLiveChange" />

                        </VBox>

                        <!-- Password field -->
                        <VBox class="wsFormField">

                            <Label
                                text="Password"
                                labelFor="passwordInput"
                                class="wsInputLabel" />

                            <Input
                                id="passwordInput"
                                value="{login>/password}"
                                type="Password"
                                placeholder="Enter your password"
                                enabled="{= !${login>/busy} }"
                                liveChange=".onPasswordLiveChange"
                                submit=".onPasswordSubmit" />

                        </VBox>

                        <!-- Remember me and forgot password -->
                        <HBox
                            width="100%"
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="wsLoginOptions">

                            <CheckBox
                                id="rememberMeCheckBox"
                                text="Remember me"
                                selected="{login>/rememberMe}"
                                enabled="{= !${login>/busy} }" />

                            <Link
                                text="Forgot password?"
                                press=".onForgotPassword"
                                enabled="{= !${login>/busy} }" />

                        </HBox>

                        <!-- Sign-in button -->
                        <Button
                            id="signInButton"
                            text="Sign In"
                            type="Emphasized"
                            width="100%"
                            press=".onSignIn"
                            visible="{= !${login>/busy} }"
                            class="wsSignInButton" />

                        <!-- Loading state -->
                        <HBox
                            width="100%"
                            height="3rem"
                            justifyContent="Center"
                            alignItems="Center"
                            visible="{login>/busy}"
                            class="wsSigningInContainer">

                            <BusyIndicator
                                size="1rem"
                                class="wsSigningInIndicator" />

                            <Text
                                text="Signing in..."
                                class="wsSigningInText" />

                        </HBox>

                        <!-- Security message -->
                        <HBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="wsSecurityMessage">

                            <core:Icon
                                src="sap-icon://locked"
                                class="wsSecurityIcon" />

                            <Text
                                text="Secure enterprise access"
                                class="wsSecurityText" />

                        </HBox>

                        <Text
                            text="© 2026 WorkSphere. Powered by SAPUI5."
                            textAlign="Center"
                            class="wsLoginFooter" />

                    </VBox>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>