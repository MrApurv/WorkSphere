<mvc:View
    controllerName="com.apurv.worksphere.controller.Login"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        id="loginPage"
        showHeader="false"
        enableScrolling="false"
        class="wsLoginPage">

        <content>

            <HBox
                id="loginLayout"
                width="100%"
                height="100%"
                alignItems="Stretch"
                class="wsLoginLayout">

                <!-- WorkSphere branding section -->
                <VBox
                    id="brandingSection"
                    width="55%"
                    justifyContent="Center"
                    alignItems="Start"
                    class="wsBrandingSection">

                    <Text
                        text="WORKSPHERE"
                        class="wsBrandLabel" />

                    <Title
                        text="Transforming Employee Management with AI"
                        level="H1"
                        wrapping="true"
                        class="wsBrandTitle" />

                    <Text
                        text="An AI-powered Enterprise Employee Management Platform built using modern SAP technologies."
                        wrapping="true"
                        class="wsBrandDescription" />

                    <VBox class="wsFeatureList">

                        <HBox
                            alignItems="Center"
                            class="wsFeatureItem">

                            <core:Icon
                                src="sap-icon://employee"
                                class="wsFeatureIcon"
                                xmlns:core="sap.ui.core" />

                            <Text
                                text="Centralized employee management"
                                class="wsFeatureText" />

                        </HBox>

                        <HBox
                            alignItems="Center"
                            class="wsFeatureItem">

                            <core:Icon
                                src="sap-icon://business-objects-experience"
                                class="wsFeatureIcon"
                                xmlns:core="sap.ui.core" />

                            <Text
                                text="Workforce analytics and intelligent insights"
                                class="wsFeatureText" />

                        </HBox>

                        <HBox
                            alignItems="Center"
                            class="wsFeatureItem">

                            <core:Icon
                                src="sap-icon://collaborate"
                                class="wsFeatureIcon"
                                xmlns:core="sap.ui.core" />

                            <Text
                                text="AI-assisted HR and workforce decisions"
                                class="wsFeatureText" />

                        </HBox>

                    </VBox>

                </VBox>

                <!-- Login form section -->
                <VBox
                    id="loginFormSection"
                    width="45%"
                    justifyContent="Center"
                    alignItems="Center"
                    class="wsLoginFormSection">

                    <VBox
                        id="loginCard"
                        width="26rem"
                        class="wsLoginCard">

                        <Text
                            text="WorkSphere"
                            class="wsMobileBrandName" />

                        <Title
                            text="Welcome back"
                            level="H2"
                            class="wsLoginTitle" />

                        <Text
                            text="Sign in to access your employee workspace."
                            wrapping="true"
                            class="wsLoginSubtitle" />

                        <VBox class="wsFormField">

                            <Label
                                text="Email or User ID"
                                labelFor="usernameInput"
                                class="wsInputLabel" />

                            <Input
                                id="usernameInput"
                                width="100%"
                                type="Email"
                                placeholder="Enter your email or user ID"
                                valueLiveUpdate="true"
                                liveChange=".onUsernameLiveChange" />

                        </VBox>

                        <VBox class="wsFormField">

                            <Label
                                text="Password"
                                labelFor="passwordInput"
                                class="wsInputLabel" />

                            <Input
                                id="passwordInput"
                                width="100%"
                                type="Password"
                                placeholder="Enter your password"
                                submit=".onSignIn" />

                        </VBox>

                        <HBox
                            width="100%"
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="wsLoginOptions">

                            <CheckBox
                                id="rememberMeCheckBox"
                                text="Remember me"
                                selected="false" />

                            <Link
                                text="Forgot password?"
                                press=".onForgotPassword" />

                        </HBox>

                        <Button
                            id="signInButton"
                            text="Sign In"
                            type="Emphasized"
                            width="100%"
                            press=".onSignIn"
                            class="wsSignInButton" />

                        <HBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="wsSecurityMessage">

                            <core:Icon
                                src="sap-icon://locked"
                                class="wsSecurityIcon"
                                xmlns:core="sap.ui.core" />

                            <Text
                                text="Secure enterprise access"
                                class="wsSecurityText" />

                        </HBox>

                        <Text
                            text="© 2026 WorkSphere. Powered by SAPUI5."
                            textAlign="Center"
                            class="wsLoginFooter" />

                    </VBox>

                </VBox>

            </HBox>

        </content>

    </Page>

</mvc:View>