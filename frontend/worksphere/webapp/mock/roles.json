                "settings.read",
                "settings.manage"
            ]
        },
        {
            "id": "ROLE_HR",
            "name": "HR",
            "description": "Manages employees, organization data, attendance, leave and HR reports.",
            "permissions": [
                "dashboard.hr.read",
                "employees.read",
                "employees.create",
                "employees.update",
                "organization.read",
                "attendance.read",
                "attendance.manage",
